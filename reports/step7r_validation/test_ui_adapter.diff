+def _gen_text(field, text):
+    g = _gen_ok()
+    if field == "statement":
+        g["output"]["evidence_statements"] = [{"statement": f"{text} [E1]", "evidence_ids": ["E1"]}]
+    else:
+        g["output"][field] = text
+    return g
+
+
