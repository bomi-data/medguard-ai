# MEDGUARD AI — 환경변수 예시 (STEP 9-1 갱신: 실제 코드가 읽는 변수만 남김)
# 주의: 앱은 .env 파일을 자동으로 읽지 않습니다(python-dotenv 미사용). 셸/서비스 설정에서 환경변수로 지정하거나,
#       Streamlit 에서는 .streamlit/secrets.toml(로컬) 또는 앱 설정 > Secrets(Cloud)에 넣으면 app.py 가 환경변수로 옮깁니다.
# 실제 값을 이 파일에 넣지 마세요.

# [인증정보] 없으면 DUR/성분 점검은 동작하고 LLM 설명만 '설명 생성 서비스를 사용할 수 없습니다'로 표시됩니다.
OPENAI_API_KEY=

# [경로] 비워두면 app.py 가 저장소 루트로 설정합니다.
MEDICAL_AI_PROJECT_ROOT=
MEDGUARD_ROOT=
MEDGUARD_NB15_PATH=

# [검색 모델] 설정하지 마세요. 기본값 BAAI/bge-m3 @ 5617a9f61b028005a4858fdac845db406aefb181 이 검증 구성이며,
# 다른 값을 넣으면 resources.verify_runtime 이 불일치로 앱 시작을 중단합니다(fail-closed).
# RETRIEVAL_DENSE_MODEL=
# RETRIEVAL_DENSE_REVISION=

# [모델 캐시] 서버에서 Hugging Face 캐시 위치를 영구 디스크로 지정할 때 사용(선택). 모델을 미리 받아 둔 뒤에는 오프라인 모드 권장.
# HF_HOME=
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

# [Windows 로컬] 한글 경로·출력 인코딩
# PYTHONUTF8=1
